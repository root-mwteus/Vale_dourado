# Banco remoto (Supabase/PostgreSQL)
# Substitua pela URL do projeto e pela chave do Supabase.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=SUA_CHAVE_ANON_OU_SERVICE_ROLE

# Chave usada para assinar sessao e tokens CSRF. Obrigatoria fora do ambiente
# de desenvolvimento local (sem arquivo .env, a aplicacao recusa iniciar sem
# essa variavel). Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA

# Opcional: string de conexao Redis para o limite de tentativas de login
# (ex: Upstash - rediss://default:SENHA@HOST:PORTA). Sem essa variavel, o
# limite usa armazenamento em memoria, que so e confiavel num processo unico
# (funciona bem em desenvolvimento local, mas nao e garantido em produção
# serverless com multiplas instancias).
RATELIMIT_STORAGE_URI=rediss://default:SENHA@SEU-ENDPOINT.upstash.io:PORTA

# Modo debug do Flask ao rodar localmente com "python app.py" (1 = ligado).
# Nao tem efeito no deploy via Vercel.
FLASK_DEBUG=1
